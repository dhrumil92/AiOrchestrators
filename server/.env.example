DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/roofsolar
GEMINI_API_KEY=your_key
GROQ_API_KEY=your_key
PORT=4000
# Password reset emails. Without RESEND_API_KEY the reset link is printed in the server console.
APP_URL=http://localhost:5173
RESEND_API_KEY=your_key
EMAIL_FROM=RoofSolar <onboarding@resend.dev>
# Optional. Check the provider model lists before changing these.
GEMINI_MODEL=gemini-2.5-flash
GROQ_TEXT_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3

# Production. Uncomment these when the app runs on a host. Keep them off for local development.
# NODE_ENV=production makes the server also serve the built client and marks cookies Secure.
# NODE_ENV=production
# Number of proxies in front of the server (usually 1). Needed for per-visitor login lockouts and rate limits.
# TRUST_PROXY=1
# Only needed if the client is served from a different address than the API. Comma separated.
# CORS_ORIGIN=http://localhost:5173
# Set APP_URL (above) to the public address, for example https://solar.example.com, so reset links work.
